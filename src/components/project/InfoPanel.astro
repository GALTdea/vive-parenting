---
import type { InfoRow } from '../../types/project';
import {
	formatLastVerifiedAt,
	verificationParentMessage,
	type VerificationLevel,
} from '../../lib/projects';

interface Props {
	title?: string;
	rows: InfoRow[];
	practicalRows?: InfoRow[];
	limitations?: string[];
	verificationLevel?: VerificationLevel;
	lastVerifiedAt?: Date;
}

const {
	title = 'What parents should know',
	rows,
	practicalRows = [],
	limitations = [],
	verificationLevel,
	lastVerifiedAt,
} = Astro.props;

const showPractical = practicalRows.length > 0;
const showLimitations = limitations.length > 0;
const showVerification = verificationLevel !== undefined;
const showMainRows = rows.length > 0;
---

<section
	aria-labelledby="parent-info-heading"
	class="rounded-2xl border border-border bg-card p-6 sm:p-8"
>
	<h2 id="parent-info-heading" class="text-lg font-semibold tracking-tight text-ink">
		{title}
	</h2>

	{
		showMainRows && (
			<dl class="mt-6 divide-y divide-border">
				{rows.map((row) => (
					<div class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[11rem_1fr] sm:gap-6">
						<dt class="text-sm font-medium text-ink">{row.label}</dt>
						<dd class="text-sm leading-relaxed text-muted">{row.value}</dd>
					</div>
				))}
			</dl>
		)
	}

	{
		showPractical && (
			<div class:list={[showMainRows && 'mt-8 border-t border-border pt-8']}>
				<h3 class="text-sm font-semibold tracking-tight text-ink">Practical requirements</h3>
				<dl class="mt-4 divide-y divide-border">
					{practicalRows.map((row) => (
						<div class="grid gap-1 py-3 first:pt-0 last:pb-0 sm:grid-cols-[11rem_1fr] sm:gap-6">
							<dt class="text-sm font-medium text-ink">{row.label}</dt>
							<dd class="text-sm leading-relaxed text-muted">{row.value}</dd>
						</div>
					))}
				</dl>
			</div>
		)
	}

	{
		showLimitations && (
			<div
				class:list={[
					(showMainRows || showPractical) && 'mt-8 border-t border-border pt-8',
				]}
			>
				<h3 class="text-sm font-semibold tracking-tight text-ink">Things to know</h3>
				<ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
					{limitations.map((item) => (
						<li class="flex gap-2">
							<span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-muted" aria-hidden="true" />
							<span>{item}</span>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		showVerification && (
			<div
				class:list={[
					(showMainRows || showPractical || showLimitations) &&
						'mt-8 border-t border-border pt-8',
				]}
			>
				<p class="text-sm leading-relaxed text-muted">
					{verificationParentMessage(verificationLevel!)}
				</p>
				{
					lastVerifiedAt && (
						<p class="mt-2 text-xs text-muted">
							Last checked {formatLastVerifiedAt(lastVerifiedAt)}.
						</p>
					)
				}
			</div>
		)
	}
</section>
