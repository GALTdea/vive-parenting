---
interface Props {
	src: string;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="group">
	<div
		class="overflow-hidden rounded-2xl border border-border bg-ink shadow-[0_24px_60px_-24px_rgba(37,37,37,0.35)] ring-1 ring-border/60"
	>
		<div class="aspect-video w-full">
			<img
				src={src}
				alt={alt}
				width="1280"
				height="720"
				class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.01]"
				loading="eager"
				decoding="async"
			/>
		</div>
	</div>
	{
		caption && (
			<figcaption class="mt-3 text-center text-xs text-muted">{caption}</figcaption>
		)
	}
</figure>
