---
interface Props {
	href: string;
	class?: string;
	'data-ga-event'?: string;
	'data-ga-project-slug'?: string;
	'data-ga-project-name'?: string;
}

const { href, class: className, ...rest } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[className]}
	{...rest}
>
	<slot />
</a>
