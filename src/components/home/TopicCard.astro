---
interface Props {
	title: string;
	description: string;
	href: string;
	accent: 'teal' | 'coral' | 'yellow' | 'blue' | 'sage';
	ariaLabel: string;
}

const { title, description, href, accent, ariaLabel } = Astro.props;

const accentClasses = {
	teal: 'border-accent/25 bg-accent-soft/60 hover:border-accent/40 hover:bg-accent-soft',
	coral: 'border-coral/20 bg-coral-soft hover:border-coral/35 hover:bg-coral-soft/80',
	yellow: 'border-yellow/25 bg-yellow-soft hover:border-yellow/40 hover:bg-yellow-soft/90',
	blue: 'border-blue/20 bg-blue-soft hover:border-blue/35 hover:bg-blue-soft/90',
	sage: 'border-sage/25 bg-sage-soft hover:border-sage/40 hover:bg-sage-soft/90',
} as const;

const dotClasses = {
	teal: 'bg-accent',
	coral: 'bg-coral',
	yellow: 'bg-yellow',
	blue: 'bg-blue',
	sage: 'bg-sage',
} as const;
---

<a
	href={href}
	aria-label={ariaLabel}
	class:list={[
		'group flex min-h-[7.5rem] flex-col justify-between rounded-2xl border p-5 transition-colors focus-visible:border-accent sm:min-h-[8.5rem] sm:p-6',
		accentClasses[accent],
	]}
>
	<span class="flex items-center gap-2.5">
		<span class:list={['h-2 w-2 shrink-0 rounded-full', dotClasses[accent]]} aria-hidden="true"></span>
		<span class="text-lg font-bold tracking-tight text-ink group-hover:text-accent">{title}</span>
	</span>
	<p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
</a>
