---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-canvas">
	<div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
		<p class="max-w-xl text-sm leading-relaxed text-muted">
			An independent project about kids, learning, and the things people are building.
		</p>
		<nav aria-label="Legal and privacy" class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
			<a
				href="/privacy/"
				class="font-medium text-muted underline-offset-2 transition-colors hover:text-accent hover:underline"
			>
				Privacy Policy
			</a>
			<button
				type="button"
				data-open-privacy-settings
				class="font-medium text-muted underline-offset-2 transition-colors hover:text-accent hover:underline"
			>
				Privacy Settings
			</button>
		</nav>
		<p class="mt-6 text-xs text-muted/80">© {year} Vibe Parenting</p>
	</div>
</footer>
