---
import ExternalLink from '../ExternalLink.astro';
import InfoPanel from '../project/InfoPanel.astro';
import ProjectHero from '../project/ProjectHero.astro';
import type { ProjectEntry } from '../../lib/projects';
import {
	projectCreatorBlock,
	projectResourceLinks,
	whatKidsDoParagraphs,
} from '../../lib/projects';

interface Props {
	project: ProjectEntry;
	Content?: Awaited<ReturnType<typeof import('astro:content').render>>['Content'];
}

const { project, Content } = Astro.props;
const { data } = project;
const whatKidsDo = whatKidsDoParagraphs(project);
const creator = projectCreatorBlock(project);
const resources = projectResourceLinks(project);
const showMarkdownBody = Content !== undefined;
---

<article>
	<ProjectHero
		category={data.category ?? data.learningAreas[0]}
		name={data.title}
		shortDescription={data.summary}
		ageRange={data.ageRange ?? 'Not specified'}
		projectType={data.projectType}
		tryUrl={data.projectUrl}
		demoUrl={data.demoUrl}
		media={
			data.media ?? {
				src: data.coverImage ?? '/favicon.svg',
				alt: data.title,
			}
		}
	/>

	<div class="mx-auto max-w-6xl px-5 py-12 sm:px-6 sm:py-16 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-16 xl:gap-20">
			<div class="min-w-0 space-y-12">
				{
					showMarkdownBody && (
						<section aria-labelledby="project-overview" class="prose-editorial max-w-2xl">
							<h2 id="project-overview" class="text-2xl font-semibold tracking-tight text-ink">
								Overview
							</h2>
							<div class="mt-4 text-base">
								<Content />
							</div>
						</section>
					)
				}

				{
					whatKidsDo.length > 0 && (
						<section aria-labelledby="what-kids-do">
							<h2 id="what-kids-do" class="text-2xl font-semibold tracking-tight text-ink">
								What kids actually do
							</h2>
							<div class="prose-editorial mt-4 max-w-2xl text-base">
								{whatKidsDo.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						</section>
					)
				}

				{
					data.learningAreas.length > 0 && (
						<section aria-labelledby="what-kids-learn">
							<h2 id="what-kids-learn" class="text-2xl font-semibold tracking-tight text-ink">
								What kids can learn
							</h2>
							<p class="prose-editorial mt-3 max-w-2xl text-sm">
								These are learning areas the project is designed to support—not guaranteed outcomes.
							</p>
							<ul class="mt-5 space-y-3">
								{data.learningAreas.map((area) => (
									<li class="flex gap-3 text-muted">
										<span
											class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
											aria-hidden="true"
										/>
										<span class="leading-relaxed">{area}</span>
									</li>
								))}
							</ul>
						</section>
					)
				}

				{
					data.whyInteresting && (
						<section aria-labelledby="why-interesting">
							<h2 id="why-interesting" class="text-2xl font-semibold tracking-tight text-ink">
								Why it's interesting
							</h2>
							<p class="prose-editorial mt-4 max-w-2xl text-base">{data.whyInteresting}</p>
						</section>
					)
				}

				{
					data.parentNotes && (
						<section aria-labelledby="parent-notes">
							<h2 id="parent-notes" class="text-2xl font-semibold tracking-tight text-ink">
								What parents should know
							</h2>
							<p class="prose-editorial mt-4 max-w-2xl text-base">{data.parentNotes}</p>
						</section>
					)
				}

				{
					creator && creator.description && (
						<section aria-labelledby="about-creator">
							<h2 id="about-creator" class="text-2xl font-semibold tracking-tight text-ink">
								About the creator
							</h2>
							<div class="mt-4 max-w-2xl rounded-2xl border border-border bg-card p-6">
								<p class="text-lg font-semibold text-ink">{creator.name}</p>
								<p class="prose-editorial mt-3 text-base">{creator.description}</p>
								<p class="mt-4">
									<ExternalLink
										href={creator.profileUrl}
										class="text-sm font-semibold text-accent underline-offset-4 hover:underline"
									>
										{creator.profileLabel}
									</ExternalLink>
								</p>
							</div>
						</section>
					)
				}

				{
					resources.length > 0 && (
						<section aria-labelledby="sources">
							<h2 id="sources" class="text-2xl font-semibold tracking-tight text-ink">
								Sources &amp; resources
							</h2>
							<ul class="mt-5 divide-y divide-border rounded-2xl border border-border bg-card">
								{resources.map((resource) => (
									<li>
										<ExternalLink
											href={resource.href}
											class="block px-5 py-4 transition-colors hover:bg-accent-soft/30 sm:px-6"
										>
											<span class="font-semibold text-ink">{resource.label}</span>
											{
												resource.description && (
													<span class="mt-1 block text-sm text-muted">
														{resource.description}
													</span>
												)
											}
										</ExternalLink>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</div>

			{
				data.parentInfo && data.parentInfo.length > 0 && (
					<aside class="lg:sticky lg:top-8 lg:self-start">
						<InfoPanel rows={data.parentInfo} />
					</aside>
				)
			}
		</div>
	</div>
</article>
