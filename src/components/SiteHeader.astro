---
const navItems = [{ label: 'Explore Projects', href: '/projects/' }];
---

<header class="border-b border-border bg-canvas/90 backdrop-blur-sm">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4 sm:px-6 lg:px-8">
		<a
			href="/"
			class="text-lg font-semibold tracking-tight text-ink transition-colors hover:text-accent"
		>
			Vibe Parenting
		</a>
		<nav aria-label="Primary">
			<ul class="flex flex-wrap items-center gap-1 sm:gap-2">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class="rounded-full px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-accent-soft hover:text-accent"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
