---
const navItems = [
	{ label: 'Explore Projects', href: '/projects/' },
	{ label: 'Submit a Project', href: '/submit/' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-canvas/95 backdrop-blur-md">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5 sm:px-6 sm:py-4 lg:px-8">
		<a
			href="/"
			class="text-lg font-bold tracking-tight text-ink transition-colors hover:text-accent"
		>
			Vibe Parenting
		</a>
		<nav aria-label="Primary">
			<ul class="flex flex-wrap items-center justify-end gap-2">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class="inline-flex min-h-11 items-center rounded-full border border-transparent px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent/20 hover:bg-accent-soft/60 hover:text-accent"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
